{
	"name": "JoinDataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "SqlLinkedService",
						"type": "LinkedServiceReference"
					},
					"name": "Customer"
				},
				{
					"linkedService": {
						"referenceName": "SqlLinkedService",
						"type": "LinkedServiceReference"
					},
					"name": "CustomerAddress"
				},
				{
					"linkedService": {
						"referenceName": "SqlLinkedService",
						"type": "LinkedServiceReference"
					},
					"name": "Address"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					},
					"name": "MainOfficeSink"
				},
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					},
					"name": "OtherAddressSink"
				}
			],
			"transformations": [
				{
					"name": "CustomerSelectFilter"
				},
				{
					"name": "CustomerAddressSelectFilter"
				},
				{
					"name": "AddressSelectFilter"
				},
				{
					"name": "FirstJoin"
				},
				{
					"name": "SecondJoin"
				},
				{
					"name": "SelectAfterJoin"
				},
				{
					"name": "SplitByAddressType"
				}
			],
			"scriptLines": [
				"source(output(",
				"          CustomerID as integer,",
				"          NameStyle as boolean,",
				"          Title as string,",
				"          FirstName as string,",
				"          MiddleName as string,",
				"          LastName as string,",
				"          Suffix as string,",
				"          CompanyName as string,",
				"          SalesPerson as string,",
				"          EmailAddress as string,",
				"          Phone as string,",
				"          PasswordHash as string,",
				"          PasswordSalt as string,",
				"          rowguid as string,",
				"          ModifiedDate as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'SalesLT',",
				"     tableName: 'Customer',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> Customer",
				"source(output(",
				"          CustomerID as integer,",
				"          AddressID as integer,",
				"          AddressType as string,",
				"          rowguid as string,",
				"          ModifiedDate as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'SalesLT',",
				"     tableName: 'CustomerAddress',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> CustomerAddress",
				"source(output(",
				"          AddressID as integer,",
				"          AddressLine1 as string,",
				"          AddressLine2 as string,",
				"          City as string,",
				"          StateProvince as string,",
				"          CountryRegion as string,",
				"          PostalCode as string,",
				"          rowguid as string,",
				"          ModifiedDate as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'SalesLT',",
				"     tableName: 'Address',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> Address",
				"Customer select(mapColumn(",
				"          CustomerID,",
				"          Title,",
				"          FirstName,",
				"          LastName,",
				"          CompanyName,",
				"          SalesPerson,",
				"          EmailAddress,",
				"          Phone",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> CustomerSelectFilter",
				"CustomerAddress select(mapColumn(",
				"          CustomerID,",
				"          AddressID,",
				"          AddressType",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> CustomerAddressSelectFilter",
				"Address select(mapColumn(",
				"          AddressID,",
				"          AddressLine1,",
				"          AddressLine2,",
				"          City,",
				"          StateProvince,",
				"          CountryRegion,",
				"          PostalCode",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> AddressSelectFilter",
				"CustomerSelectFilter, CustomerAddressSelectFilter join(CustomerSelectFilter@CustomerID == CustomerAddressSelectFilter@CustomerID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> FirstJoin",
				"FirstJoin, AddressSelectFilter join(CustomerAddressSelectFilter@AddressID == AddressSelectFilter@AddressID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> SecondJoin",
				"SecondJoin select(mapColumn(",
				"          CustomerID = CustomerSelectFilter@CustomerID,",
				"          Title,",
				"          FirstName,",
				"          LastName,",
				"          CompanyName,",
				"          SalesPerson,",
				"          EmailAddress,",
				"          Phone,",
				"          AddressID = CustomerAddressSelectFilter@AddressID,",
				"          AddressType,",
				"          AddressLine1,",
				"          AddressLine2,",
				"          City,",
				"          StateProvince,",
				"          CountryRegion,",
				"          PostalCode",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectAfterJoin",
				"SelectAfterJoin split(AddressType == 'Main Office',",
				"     disjoint: false) ~> SplitByAddressType@(MainOffice, Others)",
				"SplitByAddressType@MainOffice sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delimited',",
				"     fileSystem: 'synapse',",
				"     folderPath: 'DataMapping/Join/MainOffice',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> MainOfficeSink",
				"SplitByAddressType@Others sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delimited',",
				"     fileSystem: 'synapse',",
				"     folderPath: 'DataMapping/Join/Others',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> OtherAddressSink"
			]
		}
	}
}